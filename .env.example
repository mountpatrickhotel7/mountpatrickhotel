# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Paystack (online payments, GHS) ----
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ---- Arkesel (SMS + OTP) ----
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER_ID=MountPatrick

# ---- Email (mocked unless RESEND_API_KEY is set) ----
RESEND_API_KEY=
EMAIL_FROM=Mount Patrick Hotel <reservations@mountpatrickhotel.com>

# Signs booking QR codes (any long random string)
QR_SECRET=change-me-to-a-long-random-string

# Authorizes Vercel Cron requests to /api/cron/keep-alive
CRON_SECRET=change-me-to-a-different-long-random-string

# Supabase Send-SMS hook signing secret (v1,whsec_...) — from Auth > Hooks
SEND_SMS_HOOK_SECRET=
